<UserControl x:Class="TodoListss.App.Views.TodoItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="TodoCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsWidgetMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Padding" Value="6,5" />
                    <Setter Property="CornerRadius" Value="8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TodoTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsWidgetMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="FontSize" Value="11" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                    <Setter Property="Foreground" Value="#FF94A3B8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TodoDeleteButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Content" Value="Delete" />
            <Setter Property="ToolTip" Value="Delete" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsWidgetMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="6,2" />
                    <Setter Property="Margin" Value="6,0,0,0" />
                    <Setter Property="Content" Value="×" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="MinWidth" Value="24" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource TodoCardStyle}"
            Background="#1FFFFFFF">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsWidgetMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Margin" Value="0,0,6,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{Binding Title}"
                       TextWrapping="Wrap"
                       Style="{StaticResource TodoTitleStyle}" />

            <Button Grid.Column="2"
                    Style="{StaticResource TodoDeleteButtonStyle}"
                    Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
        </Grid>
    </Border>
</UserControl>
